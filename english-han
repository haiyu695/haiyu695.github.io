// 本地存储
const STORAGE_KEY = "engCheckData";
let data = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {
  finishedDays:[],
  startDay:1
};

const bar = document.getElementById("bar");
const progressText = document.getElementById("progressText");
const learnDayCount = document.getElementById("learnDayCount");
const dayTitle = document.getElementById("dayTitle");
const taskList = document.getElementById("taskList");
const checkBtn = document.getElementById("checkBtn");

function render(){
  const total = plan.length;
  const doneCount = data.finishedDays.length;
  const pct = (doneCount / total *100).toFixed(1);
  bar.style.width = pct+"%";
  progressText.innerText = `${doneCount}/${total}`;
  learnDayCount.innerText = doneCount;

  // 找今天应该学哪一天：取最大未完成天数
  let todayPlan = null;
  for(let p of plan){
    if(!data.finishedDays.includes(p.day)){
      todayPlan = p;
      break;
    }
  }
  if(!todayPlan){
    dayTitle.innerText = "🎉 恭喜！90天课程全部完成！";
    taskList.innerHTML = "";
    checkBtn.disabled = true;
    checkBtn.innerText = "已全部打卡完毕";
    return;
  }
  dayTitle.innerText = todayPlan.title;
  let html = "";
  todayPlan.tasks.forEach(t=>{
    html += `<div class="task-item">• ${t}</div>`;
  })
  taskList.innerHTML = html;
  checkBtn.disabled = false;
  checkBtn.onclick = ()=>{
    if(!data.finishedDays.includes(todayPlan.day)){
      data.finishedDays.push(todayPlan.day);
      localStorage.setItem(STORAGE_KEY,JSON.stringify(data));
      render();
    }
  }
}

render();
</script>
